<Window x:Class="GalvoStage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:GalvoStage.App"
        Title="振镜 + XY平台联动激光加工 · 方案预研" Height="940" Width="1500"
        WindowStartupLocation="CenterScreen" Background="#0E0E12"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#16161C"/>
        <SolidColorBrush x:Key="CardBg" Color="#1C1C24"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2C2C38"/>
        <SolidColorBrush x:Key="Fg" Color="#E4E4EC"/>
        <SolidColorBrush x:Key="FgDim" Color="#8E8E9C"/>
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
        <Color x:Key="AccentColor">#4C8DFF</Color>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>

        <!-- 滑块样式：细轨道 + 圆形拇指 -->
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,1,0,10"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#33333E" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Height="4">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Height="4">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆角按钮基样式 -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="#2A2A34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,3,6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CC2FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶部标题栏 ================= -->
        <Border Grid.Row="0" Height="52">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1B2A4A" Offset="0"/>
                    <GradientStop Color="#141821" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#4C8DFF" Margin="0,0,10,0"/>
                    <TextBlock Text="振镜 + XY 平台联动激光加工" FontSize="16" FontWeight="SemiBold"
                               Foreground="#F0F0F6" VerticalAlignment="Center"/>
                    <Border Background="#2A3A5C" CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="方案预研 · Preview" FontSize="11" Foreground="#9CC2FF"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="WPF · .NET 6 · SkiaSharp" FontSize="11" Foreground="#5E6272"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= 左侧参数面板 ================= -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,10,14">
                    <StackPanel>

                        <!-- ① 图形导入 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="①  图形导入" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnImport" Content="导入 DXF…" Click="OnImportClick"
                                            Style="{StaticResource RoundButton}" Background="#2F5AA8"/>
                                    <Button x:Name="BtnDrill" Content="导入钻孔 DXF…" Click="OnImportDrillClick"
                                            Style="{StaticResource RoundButton}" Background="#7B3F9E"/>
                                    <Button x:Name="BtnDemo" Content="加载示例图形" Click="OnLoadDemoClick"
                                            Style="{StaticResource RoundButton}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FileInfo}" Style="{StaticResource InfoText}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding DrillingInfo}" Style="{StaticResource InfoText}" 
                                           Foreground="#B4A8D6" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="BtnPlanDrill" Content="规划钻孔路径" Click="OnPlanDrillClick"
                                            Style="{StaticResource RoundButton}" Background="#5A3F8E"/>
                                    <Button x:Name="BtnExportGCode" Content="导出 G 代码…" Click="OnExportGCodeClick"
                                            Style="{StaticResource RoundButton}" Background="#3F7A5E"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ② 频率分解 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="②  频率分解（平台低频 + 振镜高频）" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource ParamLabel}">
                                    <Run Text="进给速度"/><Run Text="{Binding FeedSpeed, StringFormat=' {0:F0} mm/s'}" Foreground="#C7D6F0"/>
                                </TextBlock>
                                <Slider Minimum="10" Maximum="400" Value="{Binding FeedSpeed}" TickFrequency="10" IsSnapToTickEnabled="True"/>
                                <TextBlock Style="{StaticResource ParamLabel}">
                                    <Run Text="控制/采样频率"/><Run Text="{Binding SampleRate, StringFormat=' {0:F0} Hz'}" Foreground="#C7D6F0"/>
                                </TextBlock>
                                <Slider Minimum="500" Maximum="4000" Value="{Binding SampleRate}" TickFrequency="500" IsSnapToTickEnabled="True"/>
                                <TextBlock Style="{StaticResource ParamLabel}">
                                    <Run Text="振镜半视场"/><Run Text="{Binding GalvoFov, StringFormat=' ±{0:F1} mm'}" Foreground="#C7D6F0"/>
                                </TextBlock>
                                <Slider Minimum="1" Maximum="25" Value="{Binding GalvoFov}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                <CheckBox Content="自动搜索最优截止频率（最低平台加速度）" IsChecked="{Binding AutoCutoff}"/>
                                <TextBlock Style="{StaticResource ParamLabel}">
                                    <Run Text="截止频率"/><Run Text="{Binding CutoffHz, StringFormat=' {0:F2} Hz'}" Foreground="#C7D6F0"/>
                                </TextBlock>
                                <Slider Minimum="0.5" Maximum="40" Value="{Binding CutoffHz}"
                                        IsEnabled="{Binding AutoCutoff, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
                                <Button x:Name="BtnDecompose" Content="执行路径分解" Click="OnDecomposeClick"
                                        Style="{StaticResource RoundButton}" Background="#2F5AA8" Margin="0,4,0,0"
                                        HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding PlanInfo}" Style="{StaticResource InfoText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ③ 联动仿真 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="③  联动仿真（实时监控 + 误差补偿）" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource ParamLabel}">
                                    <Run Text="平台伺服带宽"/><Run Text="{Binding StageBandwidth, StringFormat=' {0:F0} Hz'}" Foreground="#C7D6F0"/>
                                </TextBlock>
                                <Slider Minimum="3" Maximum="50" Value="{Binding StageBandwidth}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Style="{StaticResource ParamLabel}">
                                    <Run Text="平台扰动幅值"/><Run Text="{Binding DisturbAmp, StringFormat=' {0:F3} mm'}" Foreground="#C7D6F0"/>
                                </TextBlock>
                                <Slider Minimum="0" Maximum="0.2" Value="{Binding DisturbAmp}"/>
                                <TextBlock Style="{StaticResource ParamLabel}">
                                    <Run Text="振镜时间常数"/><Run Text="{Binding GalvoTauMs, StringFormat=' {0:F2} ms'}" Foreground="#C7D6F0"/>
                                </TextBlock>
                                <Slider Minimum="0.1" Maximum="2" Value="{Binding GalvoTauMs}"/>
                                <TextBlock Style="{StaticResource ParamLabel}">
                                    <Run Text="仿真倍速"/><Run Text="{Binding SimSpeed, StringFormat=' ×{0:F1}'}" Foreground="#C7D6F0"/>
                                </TextBlock>
                                <Slider Minimum="0.1" Maximum="10" Value="{Binding SimSpeed}"/>
                                <CheckBox Content="启用误差补偿（平台跟随误差 → 振镜前馈）"
                                          IsChecked="{Binding CompensationOn}" FontWeight="SemiBold" Foreground="#7FE0A8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="BtnStart" Content="▶  开始仿真" Click="OnStartPauseClick"
                                            Style="{StaticResource RoundButton}" Background="#248A4E" Padding="18,7"/>
                                    <Button x:Name="BtnReset" Content="⟲  复位" Click="OnResetClick"
                                            Style="{StaticResource RoundButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ④ 实时状态 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="④  实时状态" Style="{StaticResource SectionHeader}"/>
                                <Border Background="#0F0F14" CornerRadius="6" Padding="10">
                                    <TextBlock Text="{Binding RealtimeInfo}" Style="{StaticResource InfoText}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource InfoText}" Foreground="#5A5A66" Margin="4,0,0,4"
                                   Text="视图操作：滚轮缩放 · 左键拖拽平移 · 双击自适应"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= 右侧画布区（平台 / 振镜 双视图 + 误差图表） ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <!-- 双轨迹视图：左=平台(世界坐标)  右=振镜(局部坐标 ±FOV) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 平台运动轨迹（世界坐标） -->
                    <Grid Grid.Column="0">
                        <skia:SKElement x:Name="StageCanvas" PaintSurface="OnPaintStage"
                                        MouseWheel="OnStageWheel" MouseDown="OnStageMouseDown"
                                        MouseMove="OnStageMouseMove" MouseUp="OnStageMouseUp"/>
                        <Border Background="#CC141821" CornerRadius="5" Padding="9,4"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,48,0,0">
                            <TextBlock Text="平台运动轨迹 · 世界坐标 (mm)" FontSize="12" FontWeight="SemiBold" Foreground="#7FB0FF"/>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{StaticResource CardBorder}" ShowsPreview="True"/>

                    <!-- 振镜运动轨迹（振镜局部坐标 ±FOV） -->
                    <Grid Grid.Column="2">
                        <skia:SKElement x:Name="GalvoCanvas" PaintSurface="OnPaintGalvo"
                                        MouseWheel="OnGalvoWheel" MouseDown="OnGalvoMouseDown"
                                        MouseMove="OnGalvoMouseMove" MouseUp="OnGalvoMouseUp"/>
                        <Border Background="#CC141821" CornerRadius="5" Padding="9,4"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,48,0,0">
                            <TextBlock Text="振镜运动轨迹 · 局部坐标 ±FOV (mm)" FontSize="12" FontWeight="SemiBold" Foreground="#FFB35C"/>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
                    <skia:SKElement x:Name="ChartCanvas" PaintSurface="OnPaintChart"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
